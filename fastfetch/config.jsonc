{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "solus",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " ❯ ",
        "color": {
            "separator": "dim_white"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "yellow",
                "at": "dim_white",
                "host": "red"
            }
        },
        "separator",
        {
            "type": "os",
            "key": " OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": " Term",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "yellow"
        },
        {
            "type": "display",
            "key": "󰍹 Display",
            "keyColor": "yellow",
            "compactType": "original"
        },
        {
            "type": "cpu",
            "key": " CPU",
            "keyColor": "red"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "red"
        },
        {
            "type": "memory",
            "key": " Memory",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": " Uptime",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
